# Source-only publication. Local research material stays at its existing paths.
# New top-level content must be explicitly selected for publication.
/*
!/.gitignore
!/AGENTS.md
!/RESEARCH_BACKGROUND.md
!/README.md
!/Project.toml
!/Manifest.toml
!/external.lock.toml

!/src/

!/examples/
/examples/*
!/examples/probing.jl
!/examples/nonprobing.jl
!/examples/rdp.jl

!/test/
/test/*
!/test/runtests.jl
!/test/phase3_structured.jl
!/test/phase3_cache.jl
!/test/phase3_incremental.jl
!/test/phase3_edgecases.jl
!/test/phase4_paper.jl

!/scripts/
/scripts/*
!/scripts/setup_external.jl
!/scripts/setup_cplex.jl
!/scripts/OriginalSources.jl

!/environments/
/environments/*
!/environments/cplex/
/environments/cplex/*
!/environments/cplex/Project.toml
!/environments/cplex/Manifest.toml

!/docs/
/docs/*
!/docs/IMPLEMENTATION_STATUS.md
!/docs/architecture.md
!/docs/mathematical_formulation.md
!/docs/algorithms.md
!/docs/structured_relaxation.md
!/docs/context_equivalence.md
!/docs/hash_based_reuse.md
!/docs/incremental_bounds.md
!/docs/phase4_source_corrections.md

# Preserve the manuscript already hosted in the GitHub repository.
!/paper/

# Generated files and local configuration, also inside selected directories.
__pycache__/
*.pyc
*.jl.cov
*.jl.mem
*.log
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
/paper/*.pdf
/paper/*.bbl
/paper/*.blg
/paper/*.out
/paper/*.toc
.env
.env.*
!.env.example
